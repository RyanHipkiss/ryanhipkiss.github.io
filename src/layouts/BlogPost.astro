---
import type { CollectionEntry } from 'astro:content';
import BaseHead from '../components/BaseHead.astro';
import Footer from '../components/Footer.astro';
import { formatDate } from '../utils/formatDate';

type Props = CollectionEntry<'blog'>['data'];

const { title, description, socialImage, publishDate } = Astro.props;
---

<!doctype html>
<html lang="en">
	<head>
		<BaseHead title={title} description={description} image={socialImage} type="article" publishDate={publishDate} />
	</head>

	<body>
		<section class="blog-header">
			<h1>{title}</h1>
			<small><i>Ryan Hipkiss, Senior Software Engineer</i></small><br>
			<small><time datetime={publishDate.toISOString().slice(0, 10)}>{formatDate(publishDate)}</time></small>
			<hr>
		</section>
		<section class="blog-content">
			<slot />
			<a href="/" class="home-link">Go Back</a>
		</section>
		<Footer />
	</body>
</html>
