---
import type { CollectionEntry } from 'astro:content';
import BaseHead from '../components/BaseHead.astro';
import Footer from '../components/Footer.astro';
import PostTiles from '../components/PostTiles.astro';
import { formatDate } from '../utils/formatDate';

type Props = CollectionEntry<'blog'>['data'] & {
	slug: string;
	readingMinutes: number;
	morePosts: CollectionEntry<'blog'>[];
};

const { title, description, socialImage, publishDate, slug, readingMinutes, morePosts } = Astro.props;
// Posts get a generated charcoal and gold share card unless they set their own image
const shareImage = socialImage ?? `/og/${slug}.png`;
---

<!doctype html>
<html lang="en">
	<head>
		<BaseHead title={`${title} | Ryan Hipkiss`} description={description} image={shareImage} type="article" publishDate={publishDate} />
	</head>

	<body>
		<header class="post-header">
			<div class="post-column">
				<a href="/" class="post-back">Back to homepage</a>
				<h1>{title}</h1>
				<p class="post-meta">
					<span>By Ryan Hipkiss</span>
					<time datetime={publishDate.toISOString().slice(0, 10)}>{formatDate(publishDate)}</time>
					<span>{readingMinutes} minute read</span>
				</p>
			</div>
		</header>

		<main class="post-column blog-content">
			<slot />
		</main>

		{morePosts.length > 0 && (
			<section class="blogs">
				<div class="content">
					<h2>More posts</h2>
					<PostTiles posts={morePosts} />
				</div>
			</section>
		)}
		<Footer />
	</body>
</html>
