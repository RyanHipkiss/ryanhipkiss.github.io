---
import type { CollectionEntry } from 'astro:content';
import BaseHead from '../components/BaseHead.astro';
import Footer from '../components/Footer.astro';
import PostTiles from '../components/PostTiles.astro';
import { formatDate } from '../utils/formatDate';
import { SHARE_IMAGE_SIZE } from '../utils/renderImage';
import { postJsonLd } from '../utils/structuredData';

type Props = CollectionEntry<'blog'>['data'] & {
	slug: string;
	readingMinutes: number;
	morePosts: CollectionEntry<'blog'>[];
};

const { title, description, socialImage, publishDate, slug, readingMinutes, morePosts } = Astro.props;
// Posts get a generated charcoal and gold share card unless they set their own image
const shareImage = socialImage ?? `/og/${slug}.png`;
const pageUrl = new URL(Astro.url.pathname, Astro.site).toString();
const jsonLd = postJsonLd({ title, description, publishDate, url: pageUrl, image: new URL(shareImage, Astro.site).toString() });
---

<!doctype html>
<html lang="en">
	<head>
		<BaseHead
			title={`${title} | Ryan Hipkiss`}
			description={description}
			image={shareImage}
			imageAlt={`${title}, by Ryan Hipkiss`}
			imageSize={socialImage ? undefined : SHARE_IMAGE_SIZE}
			type="article"
			publishDate={publishDate}
			jsonLd={jsonLd}
		/>
	</head>

	<body>
		<header class="post-header">
			<div class="post-column">
				<a href="/" class="post-back">Back to homepage</a>
				<h1>{title}</h1>
				<p class="post-meta">
					<span>By Ryan Hipkiss</span>
					<time datetime={publishDate.toISOString().slice(0, 10)}>{formatDate(publishDate)}</time>
					<span>{readingMinutes} minute read</span>
				</p>
			</div>
		</header>

		<main class="post-column blog-content">
			<slot />
		</main>

		{morePosts.length > 0 && (
			<section class="blogs">
				<div class="content">
					<h2>More posts</h2>
					<PostTiles posts={morePosts} />
				</div>
			</section>
		)}
		<Footer />
	</body>
</html>
