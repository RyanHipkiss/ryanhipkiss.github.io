---
import type { CollectionEntry } from 'astro:content';
import { formatDate } from '../utils/formatDate';

interface Props {
	posts: CollectionEntry<'blog'>[];
	/** Give the first post a double-width tile */
	featureFirst?: boolean;
}

const { posts, featureFirst = false } = Astro.props;
---

<ul class="post-grid">
	{posts.map((post, i) => (
		<li class={featureFirst && i === 0 ? 'featured' : undefined}>
			<a class="post-tile" href={`/blog/${post.slug}/`}>
				<time datetime={post.data.publishDate.toISOString().slice(0, 10)}>{formatDate(post.data.publishDate)}</time>
				<h3>{post.data.title}</h3>
				<p>{post.data.description}</p>
			</a>
		</li>
	))}
</ul>
